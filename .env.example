# Frontend
VITE_API_BASE_URL=

# API
LINKIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LINKIX_MAX_MEDIA_BYTES=104857600
LINKIX_MEDIA_HANDLE_TTL_SECONDS=900
LINKIX_RESOLVE_LIMIT_PER_MINUTE=10
LINKIX_MAX_PARALLEL_DOWNLOADS=4
LINKIX_CONNECT_RETRIES=4
LINKIX_BACKOFF_FACTOR=0.75

# Optional. Keep disabled unless you accept the privacy/availability trade-off.
LINKIX_ENABLE_PARSER_FALLBACK=false
LINKIX_PARSER_API=https://douyin.wtf/api/douyin/web/fetch_one_video
LINKIX_PARSER_TRUST_ENV=true

# Optional dedicated route for Douyin. Do not reuse Telegram credentials.
LINKIX_DOUYIN_PROXY=
